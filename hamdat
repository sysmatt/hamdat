def _date_iso_expr(col):
    """SQL expression: reformat FCC MM/DD/YYYY text column to YYYY-MM-DD for ISO comparison."""
    return f"(substr({col},7,4)||'-'||substr({col},1,2)||'-'||substr({col},4,2))"


def _resolve_date_str(s):
    """Resolve a date string to ISO YYYY-MM-DD.
    Accepts: YYYY-MM-DD, -N (N days ago), +N (N days ahead).
    """
    s = s.strip()
    m = re.match(r'^([+-])(\d+)$', s)
    if m:
        delta = timedelta(days=int(m.group(2)) * (1 if m.group(1) == '+' else -1))
        return (date.today() + delta).isoformat()
    try:
        return date.fromisoformat(s).isoformat()
    except ValueError:
        sys.exit(
            f"Invalid date: {s!r}\n"
            "Use YYYY-MM-DD, -N (N days ago), or +N (N days ahead)."
        )


def _date_cond(col, spec):
    """Return (sql_fragment, params_list) for a date filter spec against an ISO col expression.

    Formats:
      YYYY-MM-DD               exact date
      YYYY-MM-DD:YYYY-MM-DD    inclusive range (relative dates work too: -90:-30)
      since:YYYY-MM-DD         on or after DATE  — DATE itself IS included
      after:YYYY-MM-DD         strictly after DATE — DATE itself is NOT included
      thru:YYYY-MM-DD          on or before DATE — DATE itself IS included
      before:YYYY-MM-DD        strictly before DATE — DATE itself is NOT included
      -N                       last N days (BETWEEN today-N AND today)
      +N                       next N days (BETWEEN today AND today+N)
    """
    spec = spec.strip()
    # Word-prefix comparisons must be checked before the ':' range check
    if spec.startswith('since:'):
        return f"{col} >= ?", [_resolve_date_str(spec[6:])]
    if spec.startswith('thru:'):
        return f"{col} <= ?", [_resolve_date_str(spec[5:])]
    if spec.startswith('after:'):
        return f"{col} > ?", [_resolve_date_str(spec[6:])]
    if spec.startswith('before:'):
        return f"{col} < ?", [_resolve_date_str(spec[7:])]
    if ':' in spec:
        lo_s, hi_s = spec.split(':', 1)
        lo, hi = _resolve_date_str(lo_s), _resolve_date_str(hi_s)
        if lo > hi:
            lo, hi = hi, lo
        return f"{col} BETWEEN ? AND ?", [lo, hi]
    if re.match(r'^-\d+$', spec):
        # -N: last N days
        return f"{col} BETWEEN ? AND ?", [_resolve_date_str(spec), date.today().isoformat()]
    if re.match(r'^\+\d+$', spec):
        # +N: next N days
        return f"{col} BETWEEN ? AND ?", [date.today().isoformat(), _resolve_date_str(spec)]
    return f"{col} = ?", [_resolve_date_str(spec)]


def _resolve_class_codes(vals):
    """Resolve a list of class names or codes to a list of FCC operator_class codes."""
    codes = []
    for v in vals:
        v = v.strip()
        if not v:
            continue
        if v.upper() in _CLASS_NAMES:
            codes.append(v.upper())
            continue
        code = _CLASS_NAME_TO_CODE.get(v.lower())
        if code:
            codes.append(code)
            continue
        sys.exit(
            f"Unknown operator class: {v!r}\n"
            f"Valid codes: {', '.join(_CLASS_NAMES)}\n"
            f"Valid names: {', '.join(_CLASS_NAME_TO_CODE)}"
        )
    return codes


def _resolve_type_codes(vals):
    """Resolve a list of entity type names or codes to a list of FCC applicant_type_code values."""
    codes = []
    for v in vals:
        v = v.strip()
        if not v:
