        ct    = _class_or_type(rec["operator_class"], rec["applicant_type_code"])
        row   = [status, name, ct,
                 (rec["grant_date"]                or "").strip(),
                 (rec["expired_date"]              or "").strip(),
                 (rec["unique_system_identifier"]  or "").strip()]
        print("  " + "  ".join(_trunc(v, w).ljust(w) for v, w in zip(row, widths)))

    print()
    print("=" * _W)
    print()


def _class_or_type(op_class, applicant_type_code):
    """Return operator class for individuals, entity type label for everyone else."""
    oc = (op_class or "").strip()
    if oc:
        return _CLASS_NAMES.get(oc, oc)
    tc = (applicant_type_code or "").strip()
    if tc and tc != "I":
        return _APPLICANT_TYPE_NAMES.get(tc, tc)
    return ""


def _row_to_result(row):
    """Convert a joined sqlite3.Row (header + entity + amateur) to a standard result dict."""
    zc = (row["zip5"] or "")[:5]
    name = " ".join(
        p for p in [row["first_name"], row["mi"], row["last_name"]] if p
    ).strip() or (row["entity_name"] or "").strip()
    street  = (row["street_address"] or "").strip()
    po_box  = _fmt_po_box(row["po_box"])
    addr_parts = [p for p in [street, po_box] if p]
    city_st = ", ".join(p for p in [row["city"], row["state"]] if p and (p or "").strip())
    address = "  ".join(p for p in [*addr_parts, city_st, zc] if p)
    return {
        "call_sign":      (row["call_sign"]      or "").strip(),
        "name":           name,
        "operator_class": _class_or_type(row["operator_class"], row["applicant_type_code"]),
        "address":        address,
        "city":           (row["city"]            or "").strip(),
        "state":          (row["state"]           or "").strip(),
        "zip_code":       zc,
        "email":          (row["email"]           or "").strip(),
        "grant_date":     (row["grant_date"]      or "").strip(),
        "expired_date":   (row["expired_date"]    or "").strip(),
        "effective_date": (row["effective_date"]  or "").strip(),
        "last_action":    (row["last_action_date"] or "").strip(),
    }


# Per-column max display widths for table output; values longer than this are truncated
_TABLE_COL_MAX = {
    "call_sign": 10, "name": 24, "operator_class": 14, "distance_miles": 9,
    "address": 36, "city": 14, "state": 5, "zip_code": 7,
    "email": 28, "grant_date": 10, "expired_date": 10, "effective_date": 10, "last_action": 10,
}


def _trunc(s, width):
    s = "" if s is None else str(s)
    return s if len(s) <= width else s[:width - 1] + "…"


def _write_table(results, fieldnames):
    if not results:
        print("No results.")
        return
    widths = {}
    for f in fieldnames:
        cap      = _TABLE_COL_MAX.get(f, 24)
        data_max = max((len("" if r.get(f) is None else str(r.get(f))) for r in results), default=0)
        widths[f] = max(len(f), min(data_max, cap))
    header = "  ".join(f.upper().ljust(widths[f]) for f in fieldnames)
    sep    = "  ".join("─" * widths[f] for f in fieldnames)
    print(header)
    print(sep)
    for r in results:
        print("  ".join(_trunc(r.get(f, ""), widths[f]).ljust(widths[f]) for f in fieldnames))
    print(f"\n{len(results):,} result(s)")


def _write_csv(results, fieldnames, outfile):
    with open(outfile, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(results)
    print(f"{len(results):,} result(s) written to {outfile}")


def _write_json(results, fieldnames, outfile):
    out = [{f: r.get(f, "") for f in fieldnames} for r in results]
    with open(outfile, "w") as f:
        json.dump(out, f, indent=2)
    print(f"{len(results):,} result(s) written to {outfile}")


def _write_html(results, fieldnames, outfile):
    def esc(s):
        return html.escape(str(s or ""))

    lines = [
        "<!DOCTYPE html>",
        '<html><head><meta charset="utf-8">',
        "<style>",
        "body{font-family:sans-serif;font-size:13px}",
        "table{border-collapse:collapse;width:100%}",
        "th{background:#2c3e50;color:#fff;padding:6px 10px;text-align:left;white-space:nowrap}",
        "td{padding:5px 10px;border-bottom:1px solid #ddd;white-space:nowrap}",
        "tr:nth-child(even){background:#f9f9f9}",
        "tr:hover{background:#eef3f8}",
        "</style>",
        "<title>hamdat results</title></head>",
        "<body>",
        f"<p><strong>{len(results):,} result(s)</strong> &mdash; "
        f"generated {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}</p>",
        "<table><thead><tr>",
        *[f"  <th>{esc(f)}</th>" for f in fieldnames],
        "</tr></thead><tbody>",
    ]
    for r in results:
        lines.append("<tr>")
        lines.extend(f"  <td>{esc(r.get(f, ''))}</td>" for f in fieldnames)
        lines.append("</tr>")
    lines += ["</tbody></table></body></html>"]
    with open(outfile, "w") as f:
        f.write("\n".join(lines))
    print(f"{len(results):,} result(s) written to {outfile}")


def _output_results(results, fieldnames, fmt, outfile):
    """Dispatch a result list to the chosen output format."""
    if fmt == "table":
        _write_table(results, fieldnames)
    elif fmt == "csv":
        _write_csv(results, fieldnames, outfile or CACHE_DIR / "results.csv")
    elif fmt == "json":
        _write_json(results, fieldnames, outfile or CACHE_DIR / "results.json")
    elif fmt == "html":
        _write_html(results, fieldnames, outfile or CACHE_DIR / "results.html")


def _fetch_en_am(conn, usid):
    """Fetch entity and amateur rows for a given USID."""
    en = conn.execute(
        """SELECT * FROM entity WHERE unique_system_identifier = ?
           ORDER BY CASE WHEN entity_type = 'L' THEN 0 ELSE 1 END, id
           LIMIT 1""",
        (usid,),
    ).fetchone()
    am = conn.execute(
        "SELECT * FROM amateur WHERE unique_system_identifier = ? ORDER BY id DESC LIMIT 1",
        (usid,),
    ).fetchone()
    return en, am


def lookup(callsign, db_path=None, show_history=False, show_full_history=False):
    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")

    call = callsign.strip().upper()
    conn = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
    conn.row_factory = sqlite3.Row

    if show_full_history:
        all_hd_rows = conn.execute(
            """SELECT * FROM license_header WHERE call_sign = ?
               ORDER BY CASE WHEN license_status = 'A' THEN 0 ELSE 1 END,
                        last_action_date DESC, id DESC""",
            (call,),
        ).fetchall()
        if not all_hd_rows:
            print(f"No record found for callsign: {call}")
            conn.close()
            return
        full_records = []
        for rec_hd in all_hd_rows:
            rec_en, rec_am = _fetch_en_am(conn, rec_hd["unique_system_identifier"])
            full_records.append((rec_hd, rec_en, rec_am))
        fcc_history = conn.execute(
            "SELECT * FROM history WHERE call_sign = ? ORDER BY log_date DESC LIMIT 10",
            (call,),
        ).fetchall()
        conn.close()
        total = len(full_records)
        for i, (rec_hd, rec_en, rec_am) in enumerate(full_records, 1):
            label = f" Record {i} of {total} "
            dashes = "─" * ((_W - len(label)) // 2)
            print(f"\n{dashes}{label}{dashes}")
            _display_call(call, rec_hd, rec_en, rec_am, fcc_history if i == 1 else [])
        return

    # Prefer the active license; fall back to most-recently-acted-on inactive record.
    # Sorting by id DESC alone can return the wrong holder when the file load order
    # doesn't match chronological grant order.
    hd = conn.execute(
        """SELECT * FROM license_header WHERE call_sign = ?
           ORDER BY CASE WHEN license_status = 'A' THEN 0 ELSE 1 END,
                    last_action_date DESC, id DESC
           LIMIT 1""",
        (call,),
    ).fetchone()

    # Anchor entity and amateur lookups to the current license's USID so we
    # don't pick up records from a previous holder of the same callsign.
    usid = hd["unique_system_identifier"] if hd else None
    if usid:
        en, am = _fetch_en_am(conn, usid)
    else:
        en = am = None

    if not any([hd, en, am]):
        print(f"No record found for callsign: {call}")
        conn.close()
        return

    history = conn.execute(
        "SELECT * FROM history WHERE call_sign = ? ORDER BY log_date DESC LIMIT 10",
        (call,),
    ).fetchall()

    all_hd = []
    if show_history:
        all_hd = conn.execute(
            """SELECT h.*, e.first_name, e.mi, e.last_name, e.entity_name,
                      e.applicant_type_code, a.operator_class
               FROM license_header h
               LEFT JOIN entity e ON e.unique_system_identifier = h.unique_system_identifier
                    AND (e.entity_type = 'L' OR e.entity_type = '')
               LEFT JOIN amateur a ON a.unique_system_identifier = h.unique_system_identifier
               WHERE h.call_sign = ?
               ORDER BY last_action_date DESC, h.id DESC""",
            (call,),
        ).fetchall()

    conn.close()
    _display_call(call, hd, en, am, history)
    if show_history:
        _display_history_table(all_hd)


def _haversine_miles(lat1, lon1, lat2, lon2):
    R = 3958.8
    dlat = radians(lat2 - lat1)
    dlon = radians(lon2 - lon1)
    a = sin(dlat / 2) ** 2 + cos(radians(lat1)) * cos(radians(lat2)) * sin(dlon / 2) ** 2
    return R * 2 * atan2(sqrt(a), sqrt(1 - a))


def _register_regexp(conn):
    conn.create_function("REGEXP", 2,
        lambda pat, s: bool(re.search(pat, s or "", re.IGNORECASE)))


def search_multi(callsearch=None, name=None, address=None, type_code=None,
                 zipcode=None, distance_miles=0,
                 grant_date=None, change_date=None, op_class=None,
                 regex=False, fmt="table", outfile=None, db_path=None):
    """Search active operators, ANDing every criterion that is provided."""
    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")
    conn = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
    conn.row_factory = sqlite3.Row

    if regex:
        _register_regexp(conn)

    conds  = []
    params = []

    # --- ZIP radius: geocode first, then add an IN clause ---
    in_radius = {}
    ref_zip   = None
    if zipcode:
        try:
            import pgeocode
        except ImportError:
            sys.exit("Install pgeocode: pip install pgeocode")

        pgeocode.STORAGE_DIR = str(db.parent / "pgeocode")
        ref_zip = zipcode.strip().zfill(5)
        nomi    = pgeocode.Nominatim("us")
        ref     = nomi.query_postal_code(ref_zip)
        try:
            ref_lat = float(ref.latitude)
            ref_lon = float(ref.longitude)
            if isnan(ref_lat) or isnan(ref_lon):
                raise ValueError
        except (TypeError, ValueError):
            conn.close()
            sys.exit(f"Could not find coordinates for zip code: {ref_zip}")

        print("Collecting zip codes ...", end="", flush=True)
        zip_rows = conn.execute("""
            SELECT DISTINCT SUBSTR(TRIM(e.zip_code), 1, 5) AS zip5
            FROM license_header h
            JOIN entity e ON e.unique_system_identifier = h.unique_system_identifier
            WHERE h.license_status = 'A'
              AND e.zip_code IS NOT NULL AND e.zip_code != ''
        """).fetchall()
        all_zips = [r["zip5"] for r in zip_rows if r["zip5"] and len(r["zip5"]) >= 4]
        print(f" {len(all_zips):,} unique zip codes")

        print("Filtering by distance ...", end="", flush=True)
        geo_df = nomi.query_postal_code(all_zips)
        for i, zc in enumerate(all_zips):
            try:
                lat = float(geo_df.iloc[i]["latitude"])
                lon = float(geo_df.iloc[i]["longitude"])
                if isnan(lat) or isnan(lon):
                    continue
                d = _haversine_miles(ref_lat, ref_lon, lat, lon)
                if d <= distance_miles:
                    in_radius[zc] = round(d, 2)
            except (TypeError, ValueError):
                pass
        print(f" {len(in_radius):,} zip codes within {distance_miles} miles")

        if not in_radius:
            conn.close()
            print("No operators found.")
            return

        conds.append(
            f"SUBSTR(TRIM(e.zip_code), 1, 5) IN ({','.join('?' * len(in_radius))})"
        )
        params.extend(list(in_radius))

    if callsearch:
        if regex:
            conds.append("h.call_sign REGEXP ?")
            params.append(callsearch)
        else:
            conds.append("h.call_sign LIKE ?")
            params.append(f"%{callsearch}%")

    if name:
        name_expr = (
            "COALESCE(e.first_name,'') || ' ' || COALESCE(e.mi,'') || ' '"
            " || COALESCE(e.last_name,'')"
        )
        if regex:
            conds.append(f"({name_expr} REGEXP ? OR COALESCE(e.entity_name,'') REGEXP ?)")
            params.extend([name, name])
        else:
            conds.append(f"({name_expr} LIKE ? OR COALESCE(e.entity_name,'') LIKE ?)")
            params.extend([f"%{name}%", f"%{name}%"])

    if address:
        addr_cols = [
            "COALESCE(e.street_address,'')",
            "COALESCE(e.po_box,'')",
            "COALESCE(e.city,'')",
            "COALESCE(e.state,'')",
            "SUBSTR(TRIM(e.zip_code),1,5)",
        ]
        if regex:
            conds.append("(" + " OR ".join(f"{c} REGEXP ?" for c in addr_cols) + ")")
            params.extend([address] * len(addr_cols))
        else:
            conds.append("(" + " OR ".join(f"{c} LIKE ?" for c in addr_cols) + ")")
            params.extend([f"%{address}%"] * len(addr_cols))

    if type_code:
        codes = type_code if isinstance(type_code, list) else [type_code]
        ph = ",".join("?" * len(codes))
        conds.append(f"e.applicant_type_code IN ({ph})")
        params.extend(codes)

    if op_class:
        codes = op_class if isinstance(op_class, list) else [op_class]
        ph = ",".join("?" * len(codes))
        conds.append(f"a.operator_class IN ({ph})")
        params.extend(codes)

    if grant_date:
        frag, dp = _date_cond(_date_iso_expr("h.grant_date"), grant_date)
        conds.append(frag)
        params.extend(dp)

    if change_date:
        frag, dp = _date_cond(_date_iso_expr("h.last_action_date"), change_date)
        conds.append(frag)
        params.extend(dp)

    extra = "  AND " + "\n  AND ".join(conds) if conds else ""
    rows = conn.execute(_SQL_OPERATOR + extra, params).fetchall()
    conn.close()

    seen    = set()
    results = []
    for row in rows:
        usid = row["unique_system_identifier"]
        if usid in seen:
            continue
        seen.add(usid)
        result = _row_to_result(row)
        if in_radius:
            result["distance_miles"] = in_radius.get(result["zip_code"], "")
        results.append(result)

    if in_radius:
        results.sort(key=lambda r: (r.get("distance_miles") or 0, r["call_sign"]))
    else:
        results.sort(key=lambda r: r["call_sign"])

    mode  = "regex" if regex else "substring"
    parts = []
    if ref_zip:
        parts.append(f"zip={ref_zip!r} within {distance_miles} miles")
    if callsearch:
        parts.append(f"callsign={callsearch!r}")
    if name:
        parts.append(f"name={name!r}")
    if address:
        parts.append(f"address={address!r}")
    if type_code:
        codes = type_code if isinstance(type_code, list) else [type_code]
        label = "/".join(_APPLICANT_TYPE_NAMES.get(c, c) for c in codes)
        parts.append(f"type={label!r}")
    if op_class:
        codes = op_class if isinstance(op_class, list) else [op_class]
        label = "/".join(_CLASS_NAMES.get(c, c) for c in codes)
        parts.append(f"class={label!r}")
    if grant_date:
        parts.append(f"grant-date={grant_date!r}")
    if change_date:
        parts.append(f"change-date={change_date!r}")
    fields = _RADIUS_FIELDS if in_radius else _SEARCH_FIELDS
    print(f"Search ({mode}): {' AND '.join(parts)}  —  {len(results):,} result(s)")
    if in_radius:
        print(f"  (distances approximate, based on ZIP code centroid data)")
    _output_results(results, fields, fmt, outfile)


def _load_full_zip(source_zip, conn):
    """Drop all data tables, recreate schema, and load from source_zip. Returns record count."""
    cur = conn.cursor()
    for _filename, (table, _cols) in FILE_SCHEMAS.items():
        cur.execute(f'DROP TABLE IF EXISTS "{table}"')
    conn.commit()
    _create_schema(conn)

    total = 0
    with zipfile.ZipFile(source_zip) as zf:
        available = {info.filename for info in zf.infolist()}
        missing = [f for f in FILE_SCHEMAS if f not in available]
        if missing:
            print(f"  Note: archive does not contain: {', '.join(missing)}")
        for filename, (table, columns) in FILE_SCHEMAS.items():
            total += _load_dat(zf, filename, table, columns, conn,
                               or_ignore=(table == "history"))
    return total


def _pull_daily_local(conn, folder):
    """Apply daily update zips found in folder, in day-of-week order."""
    print(f"\nChecking local daily update files in {folder} ...")
    found = [(day, folder / f"l_am_{day}.zip") for day in DAILY_DAYS
             if (folder / f"l_am_{day}.zip").exists()]
    if not found:
        print("  No daily update files found.")
        return
    print(f"  Found {len(found)} file(s): {', '.join(d for d, _ in found)}")
    for day, path in found:
        print(f"  [{day}] applying {path.name} ...")
        with zipfile.ZipFile(path) as zf:
            n_records, n_usids = _apply_daily_zip(zf, conn)
        print(f"  [{day}] {n_records:,} records, {n_usids:,} licenses updated")
        conn.execute(
            "INSERT OR REPLACE INTO _daily_applied (day, etag, applied_at) VALUES (?, ?, ?)",
            (day, "", datetime.now(timezone.utc).isoformat()),
        )
        conn.commit()


def _rotate_backup(path, keep_n):
    """Copy path to a timestamped sibling, then purge old backups of that stem beyond keep_n."""
    p = Path(path)
    if not p.exists():
        return
    timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
    if keep_n > 0:
        dest = p.parent / f"{p.stem}-{timestamp}{p.suffix}"
        shutil.copy2(p, dest)
        print(f"  Backed up to {dest.name}")
    pattern = re.compile(rf'^{re.escape(p.stem)}-\d{{14}}{re.escape(p.suffix)}$')
    backups = sorted(
        [f for f in p.parent.iterdir() if pattern.match(f.name)],
        key=lambda f: f.name, reverse=True,
    )
    for old in backups[keep_n:]:
        old.unlink()
        print(f"  Purged old backup: {old.name}")


def pull(db_path=None, cache_dir=None, force=False, zips_folder=None, keep_db=None, keep_sources=None):
    global CACHE_DIR, DB_PATH, CACHE_ZIP, ETAG_FILE

    if cache_dir:
        CACHE_DIR = Path(cache_dir)
        CACHE_ZIP = CACHE_DIR / "l_amat.zip"
        ETAG_FILE = CACHE_DIR / "l_amat.etag"
    if db_path:
        DB_PATH = Path(db_path)

    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    if keep_db is not None:
        print("\nDatabase backup:")
        _rotate_backup(DB_PATH, keep_db)

    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=DELETE")
    conn.execute("PRAGMA synchronous=NORMAL")

    if zips_folder:
        # --- Local folder mode: skip all HTTP, load directly from disk ---
        folder     = Path(zips_folder)
        source_zip = folder / "l_amat.zip"
        if not source_zip.exists():
            sys.exit(f"Weekly snapshot not found in --zips-folder: {source_zip}")

        print(f"Loading from local folder: {folder}")
        print(f"  Weekly snapshot : {source_zip}")
        print(f"\nLoading into {DB_PATH}")
        total = _load_full_zip(source_zip, conn)

        now = datetime.now(timezone.utc).isoformat()
        snap_mtime = datetime.fromtimestamp(source_zip.stat().st_mtime, tz=timezone.utc)
        conn.execute("DELETE FROM _daily_applied")
        conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)", ("last_pull", now))
        conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)", ("snapshot_date", snap_mtime.isoformat()))
        conn.commit()
        print(f"\nDone. {total:,} total records loaded into {DB_PATH}")

        _pull_daily_local(conn, folder)

    else:
        # --- Remote mode: ETag check, download if changed, apply daily updates ---
        print("Checking weekly snapshot ...")
        remote_etag, snapshot_dt = _remote_meta(FCC_AMAT_URL)
        if remote_etag is None and not CACHE_ZIP.exists():
            sys.exit("Cannot reach FCC servers and no cached data available. Check network.")

        print(f"  Remote last-modified : {_fmt_dt(snapshot_dt)}")
        print(f"  Remote ETag          : {remote_etag or '(none)'}")

        cached_etag = ETAG_FILE.read_text().strip() if (ETAG_FILE.exists() and CACHE_ZIP.exists()) else ""
        print(f"  Cached ETag          : {cached_etag or '(none)'}")

        full_changed = force or not remote_etag or not cached_etag or remote_etag != cached_etag

        if full_changed:
            if force:
                print("  → --force specified; re-downloading full dataset")
            elif not remote_etag:
                print("  → could not read remote ETag; re-downloading to be safe")
            elif not cached_etag:
                print("  → no cached copy found; downloading full dataset")
            else:
                print("  → ETag changed; downloading updated full dataset")
            if keep_sources is not None:
                print("\nSource backup (weekly):")
                _rotate_backup(CACHE_ZIP, keep_sources)
            _download(FCC_AMAT_URL, CACHE_ZIP)
            if remote_etag:
                ETAG_FILE.write_text(remote_etag)
        else:
            print("  → ETag unchanged; full dataset is current, skipping download")

        if full_changed:
            print(f"\nLoading into {DB_PATH}")
            total = _load_full_zip(CACHE_ZIP, conn)

            now = datetime.now(timezone.utc).isoformat()
            conn.execute("DELETE FROM _daily_applied")
            conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)", ("last_pull", now))
            if snapshot_dt:
                conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)",
                             ("snapshot_date", snapshot_dt.isoformat()))
            conn.commit()
            print(f"\nDone. {total:,} total records loaded into {DB_PATH}")
        else:
            _create_schema(conn)  # Ensures new tables/indexes exist on schema upgrades

        _pull_daily(conn, force=force, keep_sources=keep_sources)

    conn.close()

    print("\nSeeding pgeocode ZIP cache ...")
    try:
        import pgeocode
        pgeocode.STORAGE_DIR = str(DB_PATH.parent / "pgeocode")
        pgeocode.Nominatim("us")
        print("  pgeocode cache ready.")
    except ImportError:
        print("  pgeocode not installed; skipping (install it to enable --zip radius search).")


def _pgeocode_cache_info(db_path=None):
    """Return info about the pgeocode US postal data cache."""
    try:
        import pgeocode  # noqa: F401
    except ImportError:
        return {"installed": False}

    cache_dir = Path(db_path or DB_PATH).parent / "pgeocode"

    if not cache_dir.exists():
        return {"installed": True, "cache_dir": cache_dir, "cached": False}

    files = sorted(
        (f for f in cache_dir.iterdir() if f.is_file()),
        key=lambda f: f.stat().st_mtime,
        reverse=True,
    )
    if not files:
        return {"installed": True, "cache_dir": cache_dir, "cached": False}

    newest_mtime = datetime.fromtimestamp(files[0].stat().st_mtime, tz=timezone.utc)
    total_size   = sum(f.stat().st_size for f in files)
    return {
        "installed":   True,
        "cached":      True,
        "cache_dir":   cache_dir,
        "mtime":       newest_mtime,
        "file_count":  len(files),
        "total_size":  total_size,
    }


def show_status(db_path=None, cache_dir=None):
    db       = Path(db_path   or DB_PATH)
    cdir     = Path(cache_dir or CACHE_DIR)
    lw       = 22

    # ── Database ──────────────────────────────────────────────────────────────
    print(f"\nDatabase: {db}")
    if not db.exists():
        print("  Not found — run --pull first.")
    else:
        size_mb = db.stat().st_size / 1_048_576
        print(f"  {'Size':<{lw}} {size_mb:.1f} MB")

        conn = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
        conn.row_factory = sqlite3.Row

        meta = {r["key"]: r["value"]
                for r in conn.execute("SELECT key, value FROM _meta").fetchall()}

        snapshot = meta.get("snapshot_date", "")
        last_pull = meta.get("last_pull", "")
        print(f"  {'Snapshot date':<{lw}} {snapshot[:16] + ' UTC' if snapshot else 'unknown'}")
        print(f"  {'Last pull':<{lw}} {last_pull[:16] + ' UTC' if last_pull else 'unknown'}")

        daily_rows = conn.execute(
            "SELECT day, etag, applied_at FROM _daily_applied ORDER BY applied_at"
        ).fetchall()
        if daily_rows:
            days_str  = ", ".join(r["day"] for r in daily_rows)
            latest_at = max((r["applied_at"] or "") for r in daily_rows)
            print(f"  {'Daily updates':<{lw}} {days_str}")
            print(f"  {'  last applied':<{lw}} {latest_at[:16] + ' UTC' if latest_at else 'unknown'}")
        else:
            print(f"  {'Daily updates':<{lw}} none applied")

        print()
        table_labels = [
            ("license_header", "License headers"),
            ("entity",         "Entity records"),
            ("amateur",        "Amateur records"),
            ("history",        "History entries"),
            ("comments",       "Comments"),
        ]
        print(f"  {'Table':<24} {'Records':>14}")
        print(f"  {'─' * 24} {'─' * 14}")
        for table, label in table_labels:
            try:
                n = conn.execute(f'SELECT COUNT(*) FROM "{table}"').fetchone()[0]
                print(f"  {label:<24} {n:>14,}")
            except sqlite3.OperationalError:
                print(f"  {label:<24} {'(missing)':>14}")
        conn.close()

    # ── Weekly snapshot cache file ─────────────────────────────────────────────
    cache_zip  = cdir / "l_amat.zip"
    etag_file  = cdir / "l_amat.etag"
    print(f"\nWeekly snapshot cache: {cache_zip}")
    if cache_zip.exists():
        zip_mb    = cache_zip.stat().st_size / 1_048_576
        zip_mtime = datetime.fromtimestamp(cache_zip.stat().st_mtime, tz=timezone.utc)
        etag      = etag_file.read_text().strip() if etag_file.exists() else "(none)"
        print(f"  {'Size':<{lw}} {zip_mb:.1f} MB")
        print(f"  {'Downloaded':<{lw}} {_fmt_dt(zip_mtime)}")
        print(f"  {'ETag':<{lw}} {etag}")
    else:
        print("  Not downloaded — run --pull first.")

    # ── pgeocode ZIP cache ─────────────────────────────────────────────────────
    geo = _pgeocode_cache_info(db_path=db_path)
    print(f"\npgeocode ZIP cache:")
    if not geo["installed"]:
        print("  Not installed — install pgeocode to enable --zip radius search.")
    elif not geo.get("cached"):
        print(f"  Installed but not seeded — run --pull to cache ZIP data.")
        print(f"  {'Cache path':<{lw}} {geo.get('cache_dir', 'unknown')}")
    else:
        size_kb = geo["total_size"] / 1024
        print(f"  {'Cached':<{lw}} {_fmt_dt(geo['mtime'])}")
        print(f"  {'Cache path':<{lw}} {geo['cache_dir']}")
        print(f"  {'Files':<{lw}} {geo['file_count']}  ({size_kb:.0f} KB)")
    print()


def main():
    parser = argparse.ArgumentParser(
        description=(
            "hamdat - FCC Amateur Radio License Database\n"
            "Author: Matt Hoskins, K2TTA  <k2tta@arrl.net>\n"
            "GitHub: https://github.com/sysmatt/hamdat"
        ),
        epilog="Data: https://www.fcc.gov/uls/transactions/daily-weekly.html",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # --- Data management ---
    parser.add_argument(
        "--status", action="store_true",
        help="Show the state of the local database, cached FCC files, and pgeocode ZIP data",
    )
    parser.add_argument(
        "--pull", action="store_true",
        help="Download FCC amateur radio license data and load into SQLite",
    )
    parser.add_argument(
        "--force", action="store_true",
        help="Force re-download even if cached data appears current",
    )
    parser.add_argument(
        "--zips-folder", metavar="DIR",
        help="Load FCC zip files from a local folder instead of downloading "
             "(expects l_amat.zip; optional l_am_sun.zip … l_am_sat.zip for daily updates)",
    )
    parser.add_argument(
        "--keep-db", metavar="N", nargs="?", const=1, default=None, type=int,
        help="Before pulling, copy the database to a timestamped backup "
             "(e.g. hamdat-20260606143022.db) and keep only the N most recent copies. "
             "--keep-db alone keeps 1; --keep-db 0 purges all existing backups. "
             "Note: each backup is ~500 MB. Backup filenames use local time.",
    )
    parser.add_argument(
        "--keep-sources", metavar="N", nargs="?", const=1, default=None, type=int,
        help="Before downloading, copy each FCC zip (weekly snapshot and daily files) to a "
             "timestamped backup (e.g. l_amat-20260606143022.zip) and keep only the N most "
             "recent copies per file. --keep-sources alone keeps 1; --keep-sources 0 purges "
             "all existing source backups. Only applies in remote (non --zips-folder) mode. "
             "Backup filenames use local time.",
    )

    # --- Queries ---
    parser.add_argument(
        "--call", metavar="CALLSIGN",
        help="Look up a single callsign and display a formatted operator profile (exact match)",
    )
    parser.add_argument(
        "--history", action="store_true",
        help="With --call: append a compact table of all past licensees for the callsign, most recent first",
    )
    parser.add_argument(
        "--full-history", action="store_true",
        help="With --call: show full formatted records for every past licensee, separated by 'Record X of Y' banners. Takes precedence over --history if both are given.",
    )
    parser.add_argument(
        "--callsearch", metavar="QUERY",
        help="Search active operators by callsign (substring or --regex); returns a list",
    )
    parser.add_argument(
        "--zip", metavar="ZIPCODE",
        help="Find active operators within --radius-miles of ZIPCODE (distances are "
             "approximate, based on ZIP code centroid data)",
    )
    parser.add_argument(
        "--name", metavar="QUERY",
        help="Search active operators by name (substring or --regex)",
    )
    parser.add_argument(
        "--address", metavar="QUERY",
        help="Search active operators by any part of mailing address (substring or --regex)",
    )
    parser.add_argument(
        "--type", metavar="TYPE", nargs="+",
        help=(
            "Filter by entity type: individual, club, races, military, government "
            "(or raw FCC code: I, B, R, M, G). Multiple values: --type individual club"
        ),
    )
    parser.add_argument(
        "--class", dest="op_class", metavar="CLASS", nargs="+",
        help=(
            "Filter by operator class. Accepts codes (T G E A N P) or full names "
            "(technician, general, extra, advanced, novice, technician plus). "
            "Multiple values: --class T G"
        ),
    )
    parser.add_argument(
        "--grant-date", metavar="DATESPEC",
        help=(
            "Filter by license grant date. "
            "Formats: YYYY-MM-DD (exact); YYYY-MM-DD:YYYY-MM-DD (inclusive range); "
            "since:DATE (on or after, DATE included); after:DATE (strictly after, DATE excluded); "
            "thru:DATE (on or before, DATE included); before:DATE (strictly before, DATE excluded); "
            "-N (last N days); +N (next N days); -90:-30 (relative range). "
            "Example: --grant-date -30"
        ),
    )
    parser.add_argument(
        "--change-date", metavar="DATESPEC",
        help=(
            "Filter by last action/change date. Accepts the same DATESPEC formats as --grant-date: "
            "since:/after:/thru:/before: prefixes, exact date, range, or relative -N/+N days. "
            "Example: --change-date -7"
        ),
    )
    parser.add_argument(
        "--regex", action="store_true",
        help="Treat --callsearch / --name / --address query as a Python regular expression",
    )
    parser.add_argument(
        "--radius-miles", type=float, default=0, metavar="MILES",
        help="Search radius in miles for --zip; 0 = exact ZIP only (default: 0). "
             "Distances are approximate based on ZIP code centroid data.",
    )

    # --- Output format (mutually exclusive) ---
    fmt_group = parser.add_mutually_exclusive_group()
    fmt_group.add_argument(
        "--table", dest="fmt", action="store_const", const="table",
        help="Print results as a formatted table to stdout (default)",
    )
    fmt_group.add_argument(
        "--csv", dest="fmt", action="store_const", const="csv",
        help="Write results as CSV to --file",
    )
    fmt_group.add_argument(
        "--json", dest="fmt", action="store_const", const="json",
        help="Write results as JSON to --file",
    )
    fmt_group.add_argument(
        "--html", dest="fmt", action="store_const", const="html",
        help="Write results as an HTML table to --file",
    )
    parser.set_defaults(fmt="table")

    # --- Paths ---
    parser.add_argument(
        "--file", default=None, metavar="PATH",
        help="Output file for --csv / --json / --html (default: ~/.hamdat/results.{ext})",
    )
    parser.add_argument(
        "--db", default=str(DB_PATH), metavar="PATH",
        help=f"SQLite database path (default: {DB_PATH})",
    )
    parser.add_argument(
        "--cache-dir", default=str(CACHE_DIR), metavar="DIR",
        help=f"Cache directory for downloaded files (default: {CACHE_DIR})",
    )

    args = parser.parse_args()
    fmt  = args.fmt

    type_code = None
    if args.type:
        type_code = _resolve_type_codes(args.type)

    op_class = None
    if args.op_class:
        raw = []
        for c in args.op_class:
            raw.extend(c.split(","))
        op_class = _resolve_class_codes(raw)

    if args.status:
        show_status(db_path=args.db, cache_dir=args.cache_dir)
    elif args.pull:
        pull(db_path=args.db, cache_dir=args.cache_dir, force=args.force,
             zips_folder=args.zips_folder, keep_db=args.keep_db,
             keep_sources=args.keep_sources)
    elif (args.zip or args.name or args.address or args.callsearch or type_code
          or op_class or args.grant_date or args.change_date):
        search_multi(callsearch=args.callsearch, name=args.name, address=args.address,
                     type_code=type_code, zipcode=args.zip,
                     distance_miles=args.radius_miles,
                     grant_date=args.grant_date, change_date=args.change_date,
                     op_class=op_class,
                     regex=args.regex, fmt=fmt, outfile=args.file, db_path=args.db)
    elif args.call:
        lookup(args.call, db_path=args.db, show_history=args.history,
               show_full_history=args.full_history)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
