def _display_history_table(all_hd):
    """Compact table of all licensees for a callsign, most recent first."""
    if not all_hd:
        return
    print()
    print(f"  LICENSEE HISTORY  ({len(all_hd)} record(s), most recent first)")
    print(_hr())

    cols   = ["STATUS", "NAME", "CLASS / TYPE", "GRANTED", "EXPIRED", "USID"]
    widths = [9, 26, 14, 10, 10, 10]

    print("  " + "  ".join(h.ljust(w) for h, w in zip(cols, widths)))
    print("  " + "  ".join("─" * w for w in widths))

    for rec in all_hd:
        status = _STATUS_NAMES.get((rec["license_status"] or "").strip(),
                                   (rec["license_status"] or "").strip())
        fn    = (rec["first_name"]  or "").strip()
        ln    = (rec["last_name"]   or "").strip()
        ename = (rec["entity_name"] or "").strip()
