def _fmt_po_box(val):
    """Normalize a raw FCC po_box field value to a displayable string.
    The FCC data stores bare box numbers (e.g. '525') most of the time,
    but sometimes includes the full label already ('PO Box 525').
    Junk values like 'none' / ' ' are discarded.
    """
    v = (val or "").strip()
    if not v or v.upper() == "NONE":
        return ""
    if "BOX" in v.upper():
        return v
    return f"PO BOX {v}"


def _hr(char="─"):
    return " " + char * (_W - 1)


def _field(label, value, lw=16):
    v = str(value).strip() if value else ""
    if not v:
        return None
    return f"  {label:<{lw}}  {v}"


