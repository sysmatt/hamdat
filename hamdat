def _trunc(s, width):
    s = "" if s is None else str(s)
    return s if len(s) <= width else s[:width - 1] + "…"


def _write_table(results, fieldnames):
    if not results:
        print("No results.")
        return
    widths = {}
    for f in fieldnames:
        cap      = _TABLE_COL_MAX.get(f, 24)
        data_max = max((len("" if r.get(f) is None else str(r.get(f))) for r in results), default=0)
        widths[f] = max(len(f), min(data_max, cap))
    header = "  ".join(f.upper().ljust(widths[f]) for f in fieldnames)
    sep    = "  ".join("─" * widths[f] for f in fieldnames)
    print(header)
    print(sep)
    for r in results:
        print("  ".join(_trunc(r.get(f, ""), widths[f]).ljust(widths[f]) for f in fieldnames))
    print(f"\n{len(results):,} result(s)")


def _write_csv(results, fieldnames, outfile):
    with open(outfile, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(results)
    print(f"{len(results):,} result(s) written to {outfile}")


def _write_json(results, fieldnames, outfile):
    out = [{f: r.get(f, "") for f in fieldnames} for r in results]
    with open(outfile, "w") as f:
        json.dump(out, f, indent=2)
    print(f"{len(results):,} result(s) written to {outfile}")


def _write_html(results, fieldnames, outfile):
    def esc(s):
        return str(s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    lines = [
        "<!DOCTYPE html>",
        '<html><head><meta charset="utf-8">',
        "<style>",
        "body{font-family:sans-serif;font-size:13px}",
        "table{border-collapse:collapse;width:100%}",
        "th{background:#2c3e50;color:#fff;padding:6px 10px;text-align:left;white-space:nowrap}",
        "td{padding:5px 10px;border-bottom:1px solid #ddd;white-space:nowrap}",
        "tr:nth-child(even){background:#f9f9f9}",
        "tr:hover{background:#eef3f8}",
        "</style>",
        "<title>hamdat results</title></head>",
        "<body>",
        f"<p><strong>{len(results):,} result(s)</strong> &mdash; "
        f"generated {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}</p>",
        "<table><thead><tr>",
        *[f"  <th>{esc(f)}</th>" for f in fieldnames],
        "</tr></thead><tbody>",
    ]
    for r in results:
        lines.append("<tr>")
        lines.extend(f"  <td>{esc(r.get(f, ''))}</td>" for f in fieldnames)
        lines.append("</tr>")
    lines += ["</tbody></table></body></html>"]
    with open(outfile, "w") as f:
        f.write("\n".join(lines))
    print(f"{len(results):,} result(s) written to {outfile}")


def _output_results(results, fieldnames, fmt, outfile):
    """Dispatch a result list to the chosen output format."""
    if fmt == "table":
        _write_table(results, fieldnames)
    elif fmt == "csv":
        _write_csv(results, fieldnames, outfile or CACHE_DIR / "results.csv")
    elif fmt == "json":
        _write_json(results, fieldnames, outfile or CACHE_DIR / "results.json")
    elif fmt == "html":
        _write_html(results, fieldnames, outfile or CACHE_DIR / "results.html")


def lookup(callsign, db_path=None):
    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")

    call = callsign.strip().upper()
    conn = sqlite3.connect(db)
    conn.row_factory = sqlite3.Row

    hd = conn.execute(
        "SELECT * FROM license_header WHERE call_sign = ? ORDER BY id DESC LIMIT 1",
        (call,),
    ).fetchone()

    # Anchor entity and amateur lookups to the current license's USID so we
    # don't pick up records from a previous holder of the same callsign.
    usid = hd["unique_system_identifier"] if hd else None

    if usid:
        en = conn.execute(
            """SELECT * FROM entity WHERE unique_system_identifier = ?
               ORDER BY CASE WHEN entity_type = 'L' THEN 0 ELSE 1 END, id
               LIMIT 1""",
            (usid,),
        ).fetchone()
        am = conn.execute(
            "SELECT * FROM amateur WHERE unique_system_identifier = ? ORDER BY id DESC LIMIT 1",
            (usid,),
        ).fetchone()
    else:
        en = None
        am = None

    if not any([hd, en, am]):
        print(f"No record found for callsign: {call}")
        conn.close()
        return

    history = conn.execute(
        "SELECT * FROM history WHERE call_sign = ? ORDER BY log_date DESC LIMIT 10",
        (call,),
    ).fetchall()

    conn.close()
    _display_call(call, hd, en, am, history)


def _haversine_miles(lat1, lon1, lat2, lon2):
    R = 3958.8
    dlat = radians(lat2 - lat1)
    dlon = radians(lon2 - lon1)
    a = sin(dlat / 2) ** 2 + cos(radians(lat1)) * cos(radians(lat2)) * sin(dlon / 2) ** 2
    return R * 2 * atan2(sqrt(a), sqrt(1 - a))


def find_radius(zipcode, distance_miles=0, fmt="table", outfile=None, db_path=None):
    try:
        import pgeocode
    except ImportError:
        sys.exit("Install pgeocode: pip install pgeocode")

    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")

    ref_zip = zipcode.strip().zfill(5)
    nomi    = pgeocode.Nominatim("us")
    ref     = nomi.query_postal_code(ref_zip)
    try:
        ref_lat = float(ref.latitude)
        ref_lon = float(ref.longitude)
        if isnan(ref_lat) or isnan(ref_lon):
            raise ValueError
    except (TypeError, ValueError):
        sys.exit(f"Could not find coordinates for zip code: {ref_zip}")

    conn = sqlite3.connect(db)
    conn.row_factory = sqlite3.Row

    # Step 1: collect all unique 5-digit zip codes from active licenses
    print("Collecting zip codes ...", end="", flush=True)
    zip_rows = conn.execute("""
        SELECT DISTINCT SUBSTR(TRIM(e.zip_code), 1, 5) AS zip5
        FROM license_header h
        JOIN entity e ON e.unique_system_identifier = h.unique_system_identifier
        WHERE h.license_status = 'A'
          AND e.zip_code IS NOT NULL AND e.zip_code != ''
    """).fetchall()
    all_zips = [r["zip5"] for r in zip_rows if r["zip5"] and len(r["zip5"]) >= 4]
    print(f" {len(all_zips):,} unique zip codes")

    # Step 2: batch geocode with pgeocode and filter to radius (all in-memory, instant)
    print("Filtering by distance ...", end="", flush=True)
    geo_df    = nomi.query_postal_code(all_zips)
    in_radius = {}  # zip5 -> distance_miles
    for i, zc in enumerate(all_zips):
        try:
            lat = float(geo_df.iloc[i]["latitude"])
            lon = float(geo_df.iloc[i]["longitude"])
            if isnan(lat) or isnan(lon):
                continue
            d = _haversine_miles(ref_lat, ref_lon, lat, lon)
            if d <= distance_miles:
                in_radius[zc] = round(d, 2)
        except (TypeError, ValueError):
            pass
    print(f" {len(in_radius):,} zip codes within {distance_miles} miles")

    if not in_radius:
        conn.close()
        print("No operators found.")
        return

    # Step 3: fetch operators whose zip falls in the radius
    placeholders = ",".join("?" * len(in_radius))
    rows = conn.execute(
        _SQL_OPERATOR + f"  AND SUBSTR(TRIM(e.zip_code), 1, 5) IN ({placeholders})",
        list(in_radius),
    ).fetchall()
    conn.close()

    seen    = set()
    results = []
    for row in rows:
        usid = row["unique_system_identifier"]
        if usid in seen:
            continue
        seen.add(usid)
        result = _row_to_result(row)
        result["distance_miles"] = in_radius.get(result["zip_code"], "")
        results.append(result)

    results.sort(key=lambda r: (r["distance_miles"], r["call_sign"]))
    print(f"Found {len(results):,} operators within {distance_miles} miles of {ref_zip} (distances approximate)")
    _output_results(results, _RADIUS_FIELDS, fmt, outfile)


def _register_regexp(conn):
    conn.create_function("REGEXP", 2,
        lambda pat, s: bool(re.search(pat, s or "", re.IGNORECASE)))


def search_name(query, regex=False, fmt="table", outfile=None, db_path=None):
    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")
    conn = sqlite3.connect(db)
    conn.row_factory = sqlite3.Row

    name_expr = (
        "COALESCE(e.first_name,'') || ' ' || COALESCE(e.mi,'') || ' ' || COALESCE(e.last_name,'')"
    )
    if regex:
        _register_regexp(conn)
        cond   = f"({name_expr} REGEXP ? OR COALESCE(e.entity_name,'') REGEXP ?)"
        params = [query, query]
    else:
        like   = f"%{query}%"
        cond   = f"({name_expr} LIKE ? OR COALESCE(e.entity_name,'') LIKE ?)"
        params = [like, like]

    rows = conn.execute(_SQL_OPERATOR + f"  AND {cond}", params).fetchall()
    conn.close()

    seen    = set()
    results = []
    for row in rows:
        usid = row["unique_system_identifier"]
        if usid in seen:
            continue
        seen.add(usid)
        results.append(_row_to_result(row))
    results.sort(key=lambda r: r["name"].lower())

    mode = "regex" if regex else "substring"
    print(f"Name search ({mode}): '{query}'  —  {len(results):,} result(s)")
    _output_results(results, _SEARCH_FIELDS, fmt, outfile)


def search_address(query, regex=False, fmt="table", outfile=None, db_path=None):
    db = Path(db_path or DB_PATH)
    if not db.exists():
        sys.exit(f"Database not found: {db}\nRun --pull first.")
    conn = sqlite3.connect(db)
    conn.row_factory = sqlite3.Row

    addr_cols = [
        "COALESCE(e.street_address,'')",
        "COALESCE(e.po_box,'')",
        "COALESCE(e.city,'')",
        "COALESCE(e.state,'')",
        "SUBSTR(TRIM(e.zip_code),1,5)",
    ]
    if regex:
        _register_regexp(conn)
        cond   = "(" + " OR ".join(f"{c} REGEXP ?" for c in addr_cols) + ")"
        params = [query] * len(addr_cols)
    else:
        like   = f"%{query}%"
        cond   = "(" + " OR ".join(f"{c} LIKE ?" for c in addr_cols) + ")"
        params = [like] * len(addr_cols)

    rows = conn.execute(_SQL_OPERATOR + f"  AND {cond}", params).fetchall()
    conn.close()

    seen    = set()
    results = []
    for row in rows:
        usid = row["unique_system_identifier"]
        if usid in seen:
            continue
        seen.add(usid)
        results.append(_row_to_result(row))
    results.sort(key=lambda r: (r["state"], r["city"], r["name"].lower()))

    mode = "regex" if regex else "substring"
    print(f"Address search ({mode}): '{query}'  —  {len(results):,} result(s)")
    _output_results(results, _SEARCH_FIELDS, fmt, outfile)


def _load_full_zip(source_zip, conn):
    """Drop all data tables, recreate schema, and load from source_zip. Returns record count."""
    cur = conn.cursor()
    for _filename, (table, _cols) in FILE_SCHEMAS.items():
        cur.execute(f'DROP TABLE IF EXISTS "{table}"')
    conn.commit()
    _create_schema(conn)

    total = 0
    with zipfile.ZipFile(source_zip) as zf:
        available = {info.filename for info in zf.infolist()}
        missing = [f for f in FILE_SCHEMAS if f not in available]
        if missing:
            print(f"  Note: archive does not contain: {', '.join(missing)}")
        for filename, (table, columns) in FILE_SCHEMAS.items():
            total += _load_dat(zf, filename, table, columns, conn,
                               or_ignore=(table == "history"))
    return total


def _pull_daily_local(conn, folder):
    """Apply daily update zips found in folder, in day-of-week order."""
    print(f"\nChecking local daily update files in {folder} ...")
    found = [(day, folder / f"l_am_{day}.zip") for day in DAILY_DAYS
             if (folder / f"l_am_{day}.zip").exists()]
    if not found:
        print("  No daily update files found.")
        return
    print(f"  Found {len(found)} file(s): {', '.join(d for d, _ in found)}")
    for day, path in found:
        print(f"  [{day}] applying {path.name} ...")
        with zipfile.ZipFile(path) as zf:
            n_records, n_usids = _apply_daily_zip(zf, conn)
        print(f"  [{day}] {n_records:,} records, {n_usids:,} licenses updated")
        conn.commit()


def pull(db_path=None, cache_dir=None, force=False, zips_folder=None):
    global CACHE_DIR, DB_PATH, CACHE_ZIP, ETAG_FILE

    if cache_dir:
        CACHE_DIR = Path(cache_dir)
        CACHE_ZIP = CACHE_DIR / "l_amat.zip"
        ETAG_FILE = CACHE_DIR / "l_amat.etag"
    if db_path:
        DB_PATH = Path(db_path)

    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")

    if zips_folder:
        # --- Local folder mode: skip all HTTP, load directly from disk ---
        folder     = Path(zips_folder)
        source_zip = folder / "l_amat.zip"
        if not source_zip.exists():
            sys.exit(f"Weekly snapshot not found in --zips-folder: {source_zip}")

        print(f"Loading from local folder: {folder}")
        print(f"  Weekly snapshot : {source_zip}")
        print(f"\nLoading into {DB_PATH}")
        total = _load_full_zip(source_zip, conn)

        now = datetime.now(timezone.utc).isoformat()
        conn.execute("DELETE FROM _daily_applied")
        conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)", ("last_pull", now))
        conn.commit()
        print(f"\nDone. {total:,} total records loaded into {DB_PATH}")

        _pull_daily_local(conn, folder)

    else:
        # --- Remote mode: ETag check, download if changed, apply daily updates ---
        print("Checking weekly snapshot ...")
        remote_etag, snapshot_dt = _remote_meta(FCC_AMAT_URL)
        if remote_etag is None and not CACHE_ZIP.exists():
            sys.exit("Cannot reach FCC servers and no cached data available. Check network.")

        print(f"  Remote last-modified : {_fmt_dt(snapshot_dt)}")
        print(f"  Remote ETag          : {remote_etag or '(none)'}")

        cached_etag = ETAG_FILE.read_text().strip() if (ETAG_FILE.exists() and CACHE_ZIP.exists()) else ""
        print(f"  Cached ETag          : {cached_etag or '(none)'}")

        full_changed = force or not remote_etag or not cached_etag or remote_etag != cached_etag

        if full_changed:
            if force:
                print("  → --force specified; re-downloading full dataset")
            elif not remote_etag:
                print("  → could not read remote ETag; re-downloading to be safe")
            elif not cached_etag:
                print("  → no cached copy found; downloading full dataset")
            else:
                print("  → ETag changed; downloading updated full dataset")
            _download(FCC_AMAT_URL, CACHE_ZIP)
            if remote_etag:
                ETAG_FILE.write_text(remote_etag)
        else:
            print("  → ETag unchanged; full dataset is current, skipping download")

        if full_changed:
            print(f"\nLoading into {DB_PATH}")
            total = _load_full_zip(CACHE_ZIP, conn)

            now = datetime.now(timezone.utc).isoformat()
            conn.execute("DELETE FROM _daily_applied")
            conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)", ("last_pull", now))
            if snapshot_dt:
                conn.execute("INSERT OR REPLACE INTO _meta VALUES (?, ?)",
                             ("snapshot_date", snapshot_dt.isoformat()))
            conn.commit()
            print(f"\nDone. {total:,} total records loaded into {DB_PATH}")
        else:
            _create_schema(conn)  # Ensures new tables/indexes exist on schema upgrades

        _pull_daily(conn, force=force)

    conn.close()


def main():
    parser = argparse.ArgumentParser(
        description=(
            "hamdat - FCC Amateur Radio License Database\n"
            "Author: Matt Hoskins, K2TTA  <k2tta@arrl.net>\n"
            "GitHub: https://github.com/sysmatt/hamdat"
        ),
        epilog="Data: https://www.fcc.gov/uls/transactions/daily-weekly.html",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # --- Data management ---
    parser.add_argument(
        "--pull", action="store_true",
        help="Download FCC amateur radio license data and load into SQLite",
    )
    parser.add_argument(
        "--force", action="store_true",
        help="Force re-download even if cached data appears current",
    )
    parser.add_argument(
        "--zips-folder", metavar="DIR",
        help="Load FCC zip files from a local folder instead of downloading "
             "(expects l_amat.zip; optional l_am_sun.zip … l_am_sat.zip for daily updates)",
    )

    # --- Queries ---
    parser.add_argument(
        "--call", metavar="CALLSIGN",
        help="Look up a callsign and display a formatted operator profile",
    )
    parser.add_argument(
        "--zip", metavar="ZIPCODE",
        help="Find active operators within --radius-miles of ZIPCODE (distances are "
             "approximate, based on ZIP code centroid data)",
    )
    parser.add_argument(
        "--name", metavar="QUERY",
        help="Search active operators by name (substring or --regex)",
    )
    parser.add_argument(
        "--address", metavar="QUERY",
        help="Search active operators by any part of mailing address (substring or --regex)",
    )
    parser.add_argument(
        "--regex", action="store_true",
        help="Treat --name / --address query as a Python regular expression",
    )
    parser.add_argument(
        "--radius-miles", type=float, default=0, metavar="MILES",
        help="Search radius in miles for --zip; 0 = exact ZIP only (default: 0). "
             "Distances are approximate based on ZIP code centroid data.",
    )

    # --- Output format (mutually exclusive) ---
    fmt_group = parser.add_mutually_exclusive_group()
    fmt_group.add_argument(
        "--table", dest="fmt", action="store_const", const="table",
        help="Print results as a formatted table to stdout (default)",
    )
    fmt_group.add_argument(
        "--csv", dest="fmt", action="store_const", const="csv",
        help="Write results as CSV to --file",
    )
    fmt_group.add_argument(
        "--json", dest="fmt", action="store_const", const="json",
        help="Write results as JSON to --file",
    )
    fmt_group.add_argument(
        "--html", dest="fmt", action="store_const", const="html",
        help="Write results as an HTML table to --file",
    )
    parser.set_defaults(fmt="table")

    # --- Paths ---
    parser.add_argument(
        "--file", default=None, metavar="PATH",
        help="Output file for --csv / --json / --html (default: ~/.hamdat/results.{ext})",
    )
    parser.add_argument(
        "--db", default=str(DB_PATH), metavar="PATH",
        help=f"SQLite database path (default: {DB_PATH})",
    )
    parser.add_argument(
        "--cache-dir", default=str(CACHE_DIR), metavar="DIR",
        help=f"Cache directory for downloaded files (default: {CACHE_DIR})",
    )

    args = parser.parse_args()
    fmt  = args.fmt

    if args.pull:
        pull(db_path=args.db, cache_dir=args.cache_dir, force=args.force,
             zips_folder=args.zips_folder)
    elif args.zip:
        find_radius(args.zip, distance_miles=args.radius_miles,
                    fmt=fmt, outfile=args.file, db_path=args.db)
    elif args.name:
        search_name(args.name, regex=args.regex, fmt=fmt, outfile=args.file, db_path=args.db)
    elif args.address:
        search_address(args.address, regex=args.regex, fmt=fmt, outfile=args.file, db_path=args.db)
    elif args.call:
        lookup(args.call, db_path=args.db)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
