_TABLE_COL_MAX = {
    "call_sign": 10, "name": 24, "operator_class": 14, "distance_miles": 9,
    "address": 36, "city": 14, "state": 5, "zip_code": 7,
    "email": 28, "grant_date": 10, "expired_date": 10, "effective_date": 10, "last_action": 10,
