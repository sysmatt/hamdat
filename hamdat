def _fmt_dt(dt):
    """Format a datetime for display, or 'unknown' if None."""
    if dt is None:
        return "unknown"
    return dt.strftime("%Y-%m-%d %H:%M UTC")


def _remote_meta(url):
    """HEAD request → (etag, last_modified_dt). Returns (None, None) on failure."""
    try:
        resp = requests.head(url, timeout=15)
        resp.raise_for_status()
        etag = resp.headers.get("ETag") or None
        lm = None
        lm_str = resp.headers.get("Last-Modified", "")
        if lm_str:
            try:
                lm = parsedate_to_datetime(lm_str)
            except Exception:
                pass
        return etag, lm
    except requests.RequestException:
        return None, None


def _download(url, dest):
    print(f"Downloading {url}")
    resp = requests.get(url, stream=True, timeout=60)
    resp.raise_for_status()
    total = int(resp.headers.get("content-length", 0))
    received = 0
    with open(dest, "wb") as f:
        for chunk in resp.iter_content(chunk_size=65536):
            f.write(chunk)
            received += len(chunk)
            if total:
                pct = received * 100 // total
                print(f"\r  {pct:3d}%  {received / 1_048_576:.1f} MB", end="", flush=True)
    print(f"\r  100%  {received / 1_048_576:.1f} MB")


def _create_schema(conn):
    conn.execute("""
        CREATE TABLE IF NOT EXISTS _meta (
            key   TEXT PRIMARY KEY,
            value TEXT
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS _daily_applied (
            day        TEXT PRIMARY KEY,
            etag       TEXT,
            applied_at TEXT
        )
    """)
    for _filename, (table, columns) in FILE_SCHEMAS.items():
        col_defs = ",\n  ".join(f'"{col}" TEXT' for col in columns)
        conn.execute(f"""
            CREATE TABLE IF NOT EXISTS "{table}" (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                {col_defs}
            )
        """)

    indexes = [
        ("idx_hd_call",  "license_header", "call_sign"),
        ("idx_hd_usi",   "license_header", "unique_system_identifier"),
        ("idx_en_call",  "entity",         "call_sign"),
        ("idx_en_usi",   "entity",         "unique_system_identifier"),
        ("idx_am_call",  "amateur",        "call_sign"),
        ("idx_am_usi",   "amateur",        "unique_system_identifier"),
        ("idx_am_class", "amateur",        "operator_class"),
    ]
    for name, table, col in indexes:
        conn.execute(f'CREATE INDEX IF NOT EXISTS {name} ON "{table}"("{col}")')

    # Unique index on history prevents duplicate entries when daily files are re-applied
    try:
        conn.execute("""
            CREATE UNIQUE INDEX IF NOT EXISTS idx_hs_dedup
            ON history(unique_system_identifier, call_sign, log_date, code)
        """)
    except sqlite3.IntegrityError:
        pass  # Pre-existing duplicates; INSERT OR IGNORE still helps going forward

    conn.commit()


def _load_dat(zf, filename, table, columns, conn, or_ignore=False):
    try:
        info = zf.getinfo(filename)
    except KeyError:
        print(f"  {filename}: not in archive, skipping")
        return 0

    n_cols = len(columns)
    placeholders = ",".join("?" * n_cols)
    col_names = ",".join(f'"{c}"' for c in columns)
    verb = "INSERT OR IGNORE" if or_ignore else "INSERT"
    sql = f'{verb} INTO "{table}" ({col_names}) VALUES ({placeholders})'

    cur = conn.cursor()
    batch = []
    count = 0

    print(f"  {filename} -> {table} ...", end="", flush=True)
    with zf.open(info) as raw:
        for line in io.TextIOWrapper(raw, encoding="latin-1", errors="replace"):
            line = line.rstrip("\r\n")
            if not line:
                continue
            parts = line.split("|")
            # Drop trailing empty element from trailing pipe
            if parts and parts[-1] == "":
                parts = parts[:-1]
            # Normalize to expected column count
            if len(parts) < n_cols:
                parts.extend([""] * (n_cols - len(parts)))
            else:
                parts = parts[:n_cols]
            batch.append(parts)
            if len(batch) >= BATCH_SIZE:
                cur.executemany(sql, batch)
                count += len(batch)
                batch = []

    if batch:
        cur.executemany(sql, batch)
        count += len(batch)

    conn.commit()
    print(f" {count:,} records")
    return count


def _parse_dat_in_memory(zf, filename, columns):
    """Parse a pipe-delimited .dat from an open ZipFile into a list of row lists."""
    try:
        info = zf.getinfo(filename)
    except KeyError:
        return []
    n_cols = len(columns)
    records = []
    with zf.open(info) as raw:
        for line in io.TextIOWrapper(raw, encoding="latin-1", errors="replace"):
            line = line.rstrip("\r\n")
            if not line:
                continue
            parts = line.split("|")
            if parts and parts[-1] == "":
                parts = parts[:-1]
            if len(parts) < n_cols:
                parts.extend([""] * (n_cols - len(parts)))
            else:
                parts = parts[:n_cols]
            records.append(parts)
    return records


def _apply_daily_zip(zf, conn):
    """Apply one daily change zip to the DB. Returns (n_records, n_usids_changed)."""
    HISTORY_TABLE = "history"

    # Parse all .dat files into memory (daily zips are small, ~MB range)
    all_records = {}
    for filename, (table, columns) in FILE_SCHEMAS.items():
        recs = _parse_dat_in_memory(zf, filename, columns)
        if recs:
            all_records[table] = (columns, recs)

    # Collect USIDs touched in mutable tables so we can replace their rows cleanly
    changed_usids = set()
    for table, (columns, recs) in all_records.items():
        if table == HISTORY_TABLE:
            continue
        usid_idx = columns.index("unique_system_identifier")
        for rec in recs:
            u = rec[usid_idx]
            if u:
                changed_usids.add(u)

    # Delete stale rows for affected USIDs from every mutable table
    if changed_usids:
        mutable_tables = list(dict.fromkeys(
            t for _, (t, _) in FILE_SCHEMAS.items() if t != HISTORY_TABLE
        ))
        usid_list = list(changed_usids)
        for table in mutable_tables:
            for i in range(0, len(usid_list), BATCH_SIZE):
                batch = usid_list[i:i + BATCH_SIZE]
                ph = ",".join("?" * len(batch))
                conn.execute(
                    f'DELETE FROM "{table}" WHERE unique_system_identifier IN ({ph})',
                    batch,
                )

    # Insert updated records; history uses INSERT OR IGNORE (unique index prevents duplicates)
    n_records = 0
    for table, (columns, recs) in all_records.items():
        col_names = ",".join(f'"{c}"' for c in columns)
        ph = ",".join("?" * len(columns))
        if table == HISTORY_TABLE:
            sql = f'INSERT OR IGNORE INTO "{table}" ({col_names}) VALUES ({ph})'
        else:
            sql = f'INSERT INTO "{table}" ({col_names}) VALUES ({ph})'
        for i in range(0, len(recs), BATCH_SIZE):
            conn.executemany(sql, recs[i:i + BATCH_SIZE])
        n_records += len(recs)

    conn.commit()
    return n_records, len(changed_usids)


def _pull_daily(conn, force=False):
    """Check all 7 FCC daily change files and apply any that are newer than the DB snapshot."""
    # Snapshot date: when the weekly full file was last generated (from its Last-Modified header)
    row = conn.execute("SELECT value FROM _meta WHERE key = 'snapshot_date'").fetchone()
    snapshot_dt = None
    if row and row[0]:
        try:
            snapshot_dt = datetime.fromisoformat(row[0])
        except ValueError:
            pass

    # Load already-applied ETags so we don't re-apply the same file twice
    applied_etags = {}
    applied_dates = {}
    for r in conn.execute("SELECT day, etag, applied_at FROM _daily_applied").fetchall():
        applied_etags[r[0]] = r[1]
        applied_dates[r[0]] = r[2]

    print(f"\nChecking daily updates (snapshot baseline: {_fmt_dt(snapshot_dt)})")

    # HEAD all 7 daily files; collect candidates that are new / unprocessed
    _DT_MAX = datetime.max.replace(tzinfo=timezone.utc)
    candidates = []
    for day in DAILY_DAYS:
        url = FCC_DAILY_URL.format(day=day)
        etag, lm = _remote_meta(url)

        lm_str = _fmt_dt(lm)

        if etag is None and lm is None:
            print(f"  {day:>3}:  {lm_str}  → unreachable")
            continue

        # Already applied this exact version?
        if not force and etag and applied_etags.get(day) == etag:
            applied_at = applied_dates.get(day, "")
            print(f"  {day:>3}:  {lm_str}  → already applied ({applied_at[:16] if applied_at else '?'})")
            continue

        # Older than or same age as the weekly snapshot — data already included
        if snapshot_dt and lm and lm <= snapshot_dt:
            print(f"  {day:>3}:  {lm_str}  → predates snapshot, skipping")
            continue

        print(f"  {day:>3}:  {lm_str}  → will apply")
        candidates.append((lm or _DT_MAX, day, url, etag))

    if not candidates:
        print("  All daily files are current.")
        return

    # Apply in Last-Modified chronological order so older deltas come first
    candidates.sort()
    print(f"\nApplying {len(candidates)} daily update(s):")

    for _lm, day, url, remote_etag in candidates:
        cache_zip = CACHE_DIR / f"l_am_{day}.zip"
        _download(url, cache_zip)
        with zipfile.ZipFile(cache_zip) as zf:
            n_records, n_usids = _apply_daily_zip(zf, conn)
        print(f"  [{day}] {n_records:,} records, {n_usids:,} licenses updated")
        conn.execute(
            "INSERT OR REPLACE INTO _daily_applied (day, etag, applied_at) VALUES (?, ?, ?)",
            (day, remote_etag or "", datetime.now(timezone.utc).isoformat()),
        )
        conn.commit()


