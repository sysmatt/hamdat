def _row_to_result(row):
    """Convert a joined sqlite3.Row (header + entity + amateur) to a standard result dict."""
    row_keys = row.keys()
    zc = (row["zip5"] if "zip5" in row_keys else (row["zip_code"] or ""))[:5]
    name = " ".join(
        p for p in [row["first_name"], row["mi"], row["last_name"]] if p
    ).strip() or (row["entity_name"] or "").strip()
    street  = (row["street_address"] or "").strip()
    po_box  = _fmt_po_box(row["po_box"])
    addr_parts = [p for p in [street, po_box] if p]
    city_st = ", ".join(p for p in [row["city"], row["state"]] if p and (p or "").strip())
    address = "  ".join(p for p in [*addr_parts, city_st, zc] if p)
    return {
        "call_sign":      (row["call_sign"]      or "").strip(),
        "name":           name,
        "operator_class": _CLASS_NAMES.get(row["operator_class"] or "", row["operator_class"] or ""),
        "address":        address,
        "city":           (row["city"]            or "").strip(),
        "state":          (row["state"]           or "").strip(),
        "zip_code":       zc,
        "email":          (row["email"]           or "").strip(),
        "grant_date":     (row["grant_date"]      or "").strip(),
        "expired_date":   (row["expired_date"]    or "").strip(),
        "effective_date": (row["effective_date"]  or "").strip(),
        "last_action":    (row["last_action_date"] or "").strip(),
    }


